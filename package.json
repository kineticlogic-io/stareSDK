{
  "name": "@kineticlogic/staresdk",
  "version": "0.2.1",
  "description": "React UI components, theming and design tokens for mission and geospatial applications: the design system behind OpenStare and OpenTrack.",
  "license": "MIT",
  "author": "kineticlogic.io <parker@kineticlogic.io>",
  "homepage": "https://github.com/kineticlogic-io/stareSDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineticlogic-io/stareSDK.git"
  },
  "bugs": {
    "url": "https://github.com/kineticlogic-io/stareSDK/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "maplibre",
    "theme",
    "gis"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./code-editor": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js"
    },
    "./map-view": {
      "types": "./dist/map-view.d.ts",
      "import": "./dist/map-view.js"
    },
    "./graph-view": {
      "types": "./dist/graph-view.d.ts",
      "import": "./dist/graph-view.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./eslint/colorLiteralGate.js": "./eslint/colorLiteralGate.js"
  },
  "files": [
    "dist",
    "eslint",
    "README.md",
    "DESIGN-CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "check": "tsc -p tsconfig.json --noEmit && eslint src && vitest run --maxWorkers 2",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.11.1",
