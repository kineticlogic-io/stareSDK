    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.4",
    "@xyflow/react": "^12.12.0",
    "framer-motion": "^12.38.0",
    "maplibre-gl": "^6.11.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uplot": "^1.6.32"
  },
